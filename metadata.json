{
  "name": "miharp-openvox_ca",
  "version": "0.2.0",
  "author": "Michael Harp",
  "license": "Apache-2.0",
  "summary": "Check, extend, and distribute the OpenVox CA certificate without reissuing agent certificates",
  "source": "https://github.com/miharp/openvox_ca",
  "dependencies": [],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "SLES",
      "operatingsystemrelease": [
        "15"
      ]
    }
  ],
  "tags": [
    "openvox",
    "ca",
    "certificate",
    "ssl",
    "openbolt"
  ]
}
